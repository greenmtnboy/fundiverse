{
  "name": "fundiverse",
  "version": "0.1.45",
  "private": false,
  "description": "Buy all those stocks",
  "author": "efromvt <ethan[dot]dickinson[at]gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/greenmtnboy/fundiverse.git"
  },
  "scripts": {
    "dev": "pnpm exec vite",
    "build_debug": "pnpm exec vue-tsc && pnpm exec vite build",
    "build": "node build-backend.js && pnpm exec vue-tsc && pnpm exec vite build",
    "build_backend": "node build-backend.js",
    "preview": "pnpm exec vite preview",
    "debug_bg": "node test-bg.js",
    "dist_linux": "pnpm exec vue-tsc && pnpm exec vite build && node build-backend.js && pnpm exec electron-builder --linux snap",
    "dist_windows": "pnpm exec vue-tsc && pnpm exec vite build && node build-backend.js && pnpm exec electron-builder --win",
    "test": "pnpm exec playwright test"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.29.1-dev269.0",
    "@mdi/js": "^7.4.47",
    "@trilogy-data/trilogy-studio-components": "0.1.19",
    "dotenv": "^16.4.5",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "pinia": "^2.3.1",
    "prismjs": "^1.29.0",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue3-shortkey": "^4.0.0",
    "vuetify": "^3.7.2",
    "vuex": "^4.1.0",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "3.3.3",
    "sass": "^1.79.5",
    "sass-loader": "^16.0.2",
    "typescript": "^5.6.3",
    "vite": "^6.2.3",
    "vite-plugin-commonjs-externals": "^0.1.1",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-vuetify": "^2.0.4",
    "vue-tsc": "^2.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "esbuild"
    ]
  },
  "main": "dist-electron/main.js"
}
